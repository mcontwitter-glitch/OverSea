# MultiSea delivery service — copy to .env. NEVER commit .env or key files.
# Prefer *_FILE variants (path to a 0600 file) over inline secrets.

# --- Bitcoin (default regtest; mainnet refused unless I_UNDERSTAND_MAINNET=yes) ---
BTC_NETWORK=regtest                 # regtest | signet | testnet | mainnet
BTC_BACKEND=rpc                     # rpc (bitcoind, needs -txindex=1) | esplora (mempool.space / electrs)
BITCOIND_RPC_URL=http://127.0.0.1:18443
BITCOIND_RPC_USER=user
BITCOIND_RPC_PASS_FILE=./secrets/bitcoind_rpc_pass
BITCOIND_WATCH_WALLET=multisea-watch   # watch-only wallet created automatically (no keys in bitcoind)
# ESPLORA_URL=https://mempool.space/signet/api
# FEE_API_URL=https://mempool.space/signet/api/v1/fees/recommended
BTC_MIN_CONFS=3
FEE_RATE_FALLBACK=2                 # sat/vB when no estimate (regtest)
MAX_FEE_RATE=50                     # above this, orders are deferred, not failed
POSTAGE_SATS=546
BTC_SERVICE_PRIVKEY_FILE=./secrets/btc_service_key   # 32-byte hex; funding wallet = `npm run address`

# --- EVM ---
EVM_RPC_URL=http://127.0.0.1:8545
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
EVM_CONFIRMATIONS=2
EVM_MAX_BLOCK_RANGE=2000
POLL_MS=5000

# --- Attestation ---
ATTEST_MODE=dev                     # dev: sign with all ATTESTER_PRIVATE_KEYS locally | peer: own key + PEER_URLS
ATTESTER_PRIVATE_KEYS_FILE=./secrets/attester_keys   # dev: comma-separated
# ATTESTER_PRIVATE_KEY_FILE=./secrets/attester_key   # peer mode / attester server
# SUBMITTER_PRIVATE_KEY_FILE=./secrets/submitter_key # gas payer (defaults to first attester)
# PEER_URLS=http://attester2:8787,http://attester3:8787
# PEER_AUTH_TOKEN_FILE=./secrets/peer_token
ATTEST_SERVER_PORT=8787
SIG_TTL_SECS=3600
AUTO_RELEASE=true                   # call release() after attestation (permissionless)

# --- Content / ops ---
# CONTENT_TEMPLATE_FILE=./templates/recursive.html   # {{orderId}} {{collectionId}} {{buyer}}
CONTENT_TYPE=image/svg+xml
STATE_PATH=./data/state.json
MAX_ATTEMPTS=8
DEADLINE_SAFETY_SECS=21600          # don't start inscribing within 6h of the order's refund deadline
LOG_LEVEL=info
